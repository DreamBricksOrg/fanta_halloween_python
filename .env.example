# Paths are resolved relative to the project directory.
VIDEO_0=videos/fanta_halloween_completo.mp4

# One video made of consecutive clips. Each entry is <clip length in seconds>:<r,g,b>, separated
# by ";". The LEDs change color when each clip starts, so if you change a clip's length the
# following ones shift automatically. (For arbitrary times use VIDEO_0_CUES=0:255,96,0;75:190,0,120
# instead - seconds from the start - but never both. Cues can also be edited in the control panel.)
VIDEO_0_CLIPS=60:255,96,0;60:190,0,120;60:72,0,255;60:0,200,80

# Color used before the first cue (and for videos without cues).
VIDEO_0_RGB=255,96,0

# Optional Arduino serial output. Leave blank to disable (no assumed COM port).
SERIAL_PORT=
SERIAL_BAUD=115200

# Milliseconds to fire timeline cues early, to absorb serial latency and the Arduino's 500 ms
# fade (0 = exactly at the marked time). Raise it if the LEDs seem to lag the picture.
CUE_LEAD_MS=0

# Web control panel (playlist, LED test mode, telemetry). Use CONTROL_HOST=0.0.0.0 to open it
# to other devices on the network (there is no login). CONTROL_PORT=0 disables it.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080

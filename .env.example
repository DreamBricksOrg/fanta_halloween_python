# Paths are resolved relative to the project directory.
VIDEO_0=videos/first.mp4
VIDEO_1=videos/second.mp4
VIDEO_2=videos/third.mp4

# RGB values sent when each playlist video starts (editable without recompiling).
VIDEO_0_RGB=255,96,0
VIDEO_1_RGB=190,0,120
VIDEO_2_RGB=72,0,255

# Optional Arduino serial output. Leave blank to disable (no assumed COM port).
SERIAL_PORT=
SERIAL_BAUD=115200

# Web control panel (playlist, LED test mode, telemetry). Use CONTROL_HOST=0.0.0.0 to open it
# to other devices on the network (there is no login). CONTROL_PORT=0 disables it.
CONTROL_HOST=127.0.0.1
CONTROL_PORT=8080
